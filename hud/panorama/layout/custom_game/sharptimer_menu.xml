<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/hud_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/sharptimer_menu.vcss_c" />
	</styles>

	<!--
		!hud - where each part of the timer HUD goes. Generated by hud/tools/gen_layouts.py, driven by
		src/Hud/HudMenu.cs. The HUD itself moves behind the menu as the player clicks.

		CONTRACT
		  RootPanelId = "StMenuRoot"   RevealClass = "show"   CloseButtonId = "sm_close"   RowCount = 0
		  CaptureInput = true          SharedText = false

		BUTTONS (PanelAction.Button, by id)
		  mg_0..mg_3                 the part: timer card, speed and keys, splits, records feed
		  mz_{tl|tc|tr|ml|xa|xu|mr|bc|br}   put it there (the nine spots on the mini map)
		  mz_with                    next to the card (speed and keys) / with the card (splits)
		  ms_s ms_m ms_l             size
		  mo_hud_on|off mo_spd_on|off mo_keys_on|off mo_kl_grid|row mo_spl_on|off mo_feed_on|off
		  m_reset                    every option back to the server default

		CLASSES THE SERVER TOGGLES
		  mg_N mp_N active    sm_bar at-0..at-3    mz_* cur    mz_with on hidden    ms_* mo_* on
		  mb_card mb_cl mb_ts mb_fd   p-* | nx-<pos>-<cs>-<ks> (mb_cl) | wc-<pos>-<cs> (mb_ts)   sz-s|m|l   sel off

		DIALOG VARIABLES
		  sm_tag sm_where sm_with
	-->
	<Panel class="hud-screen" hittest="false">
		<Panel id="StMenuRoot" class="hud-root hud-card sm-root">
			<Panel class="hud-head">
				<Label class="hud-title sm-title" text="TIMER HUD" hittest="false" />
				<Label class="hud-tag sm-tag" text="{s:sm_tag}" hittest="false" />
				<Panel class="fill" hittest="false" />
				<Button id="sm_close" class="hud-exit">
					<Label class="hud-x" text="&#x2715;" hittest="false" />
				</Button>
			</Panel>
			<Panel class="sm-tabs">
				<Button id="mg_0" class="sm-tab">
					<Label class="sm-tab-lbl" text="TIMER CARD" hittest="false" />
				</Button>
				<Button id="mg_1" class="sm-tab">
					<Label class="sm-tab-lbl" text="SPEED AND KEYS" hittest="false" />
				</Button>
				<Button id="mg_2" class="sm-tab">
					<Label class="sm-tab-lbl" text="SPLITS" hittest="false" />
				</Button>
				<Button id="mg_3" class="sm-tab">
					<Label class="sm-tab-lbl" text="RECORDS FEED" hittest="false" />
				</Button>
				<Panel id="sm_bar" class="sm-bar at-0" hittest="false" />
			</Panel>
			<Panel class="sm-body" hittest="false">
				<Panel class="sm-left" hittest="false">
					<Panel class="sm-lhead" hittest="false">
						<Label class="sm-k" text="WHERE IT GOES" hittest="false" />
						<Panel class="fill" hittest="false" />
						<Label class="sm-where" text="{s:sm_where}" hittest="false" />
					</Panel>
					<Panel id="mm" class="mm" hittest="false">
						<Panel class="mm-cs mm-radar" hittest="false" />
						<Panel class="mm-cs mm-money" hittest="false" />
						<Panel class="mm-cs mm-score" hittest="false" />
						<Panel class="mm-cs mm-kill" hittest="false" />
						<Panel class="mm-cs mm-chat" hittest="false" />
						<Panel class="mm-cs mm-hp" hittest="false" />
						<Panel class="mm-cs mm-ammo" hittest="false" />
						<Panel class="mm-cs mm-x" hittest="false" />
						<Panel id="mb_fd" class="mm-blk mm-fd p-tr sz-m" hittest="false">
							<Label class="mm-blk-l" text="RECORDS" hittest="false" />
						</Panel>
						<Panel id="mb_ts" class="mm-blk mm-ts wc-bc-m sz-m" hittest="false">
							<Label class="mm-blk-l" text="SPLITS" hittest="false" />
						</Panel>
						<Panel id="mb_card" class="mm-blk mm-card p-bc sz-m sel" hittest="false">
							<Label class="mm-blk-l" text="TIMER" hittest="false" />
						</Panel>
						<Panel id="mb_cl" class="mm-blk mm-cl p-xu sz-m" hittest="false">
							<Label class="mm-blk-l" text="SPEED" hittest="false" />
						</Panel>
						<Button id="mz_tl" class="mm-z z-tl">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_tc" class="mm-z z-tc">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_tr" class="mm-z z-tr">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_ml" class="mm-z z-ml">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_xa" class="mm-z z-xa">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_xu" class="mm-z z-xu">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_mr" class="mm-z z-mr">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_bc" class="mm-z z-bc">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
						<Button id="mz_br" class="mm-z z-br">
							<Panel class="mm-z-in" hittest="false" />
						</Button>
					</Panel>
					<Panel class="sm-with" hittest="false">
						<Button id="mz_with" class="se-opt sm-with-btn">
							<Label class="se-opt-lbl" text="{s:sm_with}" hittest="false" />
						</Button>
						<Label class="sm-hint" text="Click a spot on the screen to move it." hittest="false" />
					</Panel>
				</Panel>
				<Panel class="sm-right" hittest="false">
					<Panel class="se-row" hittest="false">
						<Label class="se-k" text="SIZE" hittest="false" />
						<Panel id="ms_opts" class="se-opts" hittest="false">
							<Button id="ms_s" class="se-opt">
								<Label class="se-opt-lbl" text="S" hittest="false" />
							</Button>
							<Button id="ms_m" class="se-opt">
								<Label class="se-opt-lbl" text="M" hittest="false" />
							</Button>
							<Button id="ms_l" class="se-opt">
								<Label class="se-opt-lbl" text="L" hittest="false" />
							</Button>
						</Panel>
					</Panel>
					<Panel id="mp_0" class="sm-page" hittest="false">
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="TIMER HUD" hittest="false" />
							<Label class="se-d" text="The card, speed and keys. Same as !hud on and !hud off." hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_hud_on" class="se-opt">
									<Label class="se-opt-lbl" text="ON" hittest="false" />
								</Button>
								<Button id="mo_hud_off" class="se-opt">
									<Label class="se-opt-lbl" text="OFF" hittest="false" />
								</Button>
							</Panel>
						</Panel>
					</Panel>
					<Panel id="mp_1" class="sm-page" hittest="false">
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="SPEED" hittest="false" />
							<Label class="se-d" text="Speed, pre and sync." hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_spd_on" class="se-opt">
									<Label class="se-opt-lbl" text="ON" hittest="false" />
								</Button>
								<Button id="mo_spd_off" class="se-opt">
									<Label class="se-opt-lbl" text="OFF" hittest="false" />
								</Button>
							</Panel>
						</Panel>
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="KEYS" hittest="false" />
							<Label class="se-d" text="Same as !keys." hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_keys_on" class="se-opt">
									<Label class="se-opt-lbl" text="ON" hittest="false" />
								</Button>
								<Button id="mo_keys_off" class="se-opt">
									<Label class="se-opt-lbl" text="OFF" hittest="false" />
								</Button>
							</Panel>
						</Panel>
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="KEYS LAYOUT" hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_kl_grid" class="se-opt">
									<Label class="se-opt-lbl" text="GRID" hittest="false" />
								</Button>
								<Button id="mo_kl_row" class="se-opt">
									<Label class="se-opt-lbl" text="ONE ROW" hittest="false" />
								</Button>
							</Panel>
						</Panel>
					</Panel>
					<Panel id="mp_2" class="sm-page" hittest="false">
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="SPLITS" hittest="false" />
							<Label class="se-d" text="Stage and checkpoint times. Same as !splits." hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_spl_on" class="se-opt">
									<Label class="se-opt-lbl" text="ON" hittest="false" />
								</Button>
								<Button id="mo_spl_off" class="se-opt">
									<Label class="se-opt-lbl" text="OFF" hittest="false" />
								</Button>
							</Panel>
						</Panel>
					</Panel>
					<Panel id="mp_3" class="sm-page" hittest="false">
						<Panel class="se-row" hittest="false">
							<Label class="se-k" text="RECORDS FEED" hittest="false" />
							<Label class="se-d" text="Other players' finishes, PBs and records." hittest="false" />
							<Panel class="se-opts" hittest="false">
								<Button id="mo_feed_on" class="se-opt">
									<Label class="se-opt-lbl" text="ON" hittest="false" />
								</Button>
								<Button id="mo_feed_off" class="se-opt">
									<Label class="se-opt-lbl" text="OFF" hittest="false" />
								</Button>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
			</Panel>
			<Panel class="hud-foot sm-foot">
				<Button id="m_reset" class="sm-reset">
					<Label class="sm-reset-lbl" text="RESET ALL" hittest="false" />
				</Button>
				<Panel class="fill" hittest="false" />
				<Label class="sm-cmd" text="!hud" hittest="false" />
				<Label class="sm-foot-t" text="THIS MENU" hittest="false" />
				<Label class="sm-cmd" text="!keys" hittest="false" />
				<Label class="sm-foot-t" text="KEYS" hittest="false" />
				<Label class="sm-cmd" text="!splits" hittest="false" />
				<Label class="sm-foot-t" text="SPLITS" hittest="false" />
			</Panel>
		</Panel>
	</Panel>
</root>
