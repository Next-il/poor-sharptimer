<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/hud_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/sharptimer_hud.vcss_c" />
	</styles>

	<!--
		SharpTimer HUD - generated by hud/tools/gen_layouts.py. Driven by src/Hud/TimerHud.cs.
		Replaces the center HTML: timer card, speed, keys, one toast slot for splits and replies, a feed
		of other players' records and the map's top times. Every part sits wherever the player put it with !hud.

		CONTRACT
		  RootPanelId = "StHudRoot"   RevealClass = "show"   RowCount = 0
		  CaptureInput = false        HideHud = None         SharedText = false

		NOT INTERACTIVE. hittest false everywhere.

		STYLE (one-of classes on st_skin, which holds every part)
		  ac-{ice|orange|pink|lime|white}   op-lo|op-md|op-hi   tx-s|tx-m|tx-l   cc (compact card)

		PLACEMENT (one-of classes on the part's outer panel; size on the _sz panel)
		  st_cg st_sp st_ks st_tf st_fd st_mr   p-{tl|tc|tr|ml|xa|xu|mr|bc|br|rw}
		  st_sp                     nx-<cardpos>-<cardsize>-<speedsize> (nxc- with the compact card)   next to the card
		  st_cg_sz st_sp_sz st_ks_sz st_tf_sz st_fd_sz st_mr_sz   sz-s | sz-m | sz-l   (ui-scale 85 / 100 / 115%)

		DIALOG VARIABLES
		  sp_val sp_pre sp_sync sc_chip
		  tc_lead tc_who tc_map c_style c_mode tc_time tc_stagek tc_stage tc_place tc_diff
		  tc_pb tc_srk tc_sr tc_srby tc_rank tc_res tc_pts
		  ts_k ts_t ts_d1 ts_d2 ts_v ts_vd ts_mb ts_m          (shared by the three toast panels)
		  fdN_n fdN_tag fdN_t fdN_d   N = 0..4
		  mr_sub mr_empty mrN_p mrN_n mrN_t mr_me_p mr_me_n mr_me_t   N = 0..9

		CLASSES THE SERVER TOGGLES
		  sc        show zone flash capped vc nobar nosync
		  sp_num    v0..v10         sp_fill  p0..p50     sp_cap  cap-0..cap-50
		  ks        show v-row chute     k_w k_a k_s k_d k_e k_c k_j   on no
		  tc        show st-start|st-idle|st-run|st-done|st-pb|st-sr|st-cancel|st-replay
		            spec bonus rp-pb nosr nopb nocmp noseg noplace nostage nostyle nomode lead-empty who-empty
		            diff-ahead diff-behind rk-icon rk-text pts hint
		  tc_time   pop-a pop-b     tc_rank  rc-<chat colour>   tc_ricon  ri-<icon>
		  sg0..sg15  x cur ahead behind done        tc_prog  p0..p50
		  tu td tf  show re-a re-b k-split k-msg err hidden d1-ahead d1-behind d1-off d2-ahead d2-behind d2-off
		            vd-ahead vd-behind vd-off v-off
		  fdN hidden   fdN_row  show k-sr|k-pb|k-fin|k-stg nod
		  mr        show empty      mrN  hidden top me      mr_me  hidden
	-->
	<Panel class="hud-screen st-screen" hittest="false">
		<Panel id="StHudRoot" class="st-root" hittest="false">
			<Panel id="st_skin" class="st-skin ac-ice op-md tx-m" hittest="false">
				<!-- speed -->
				<Panel id="st_sp" class="st-pos p-xu" hittest="false">
					<Panel id="st_sp_sz" class="st-sz sz-m" hittest="false">
						<Panel id="sc" class="sc" hittest="false">
							<Panel id="sc_box" class="sc-box" hittest="false">
								<Panel class="sc-top" hittest="false">
									<Label id="sp_num" class="sc-num" text="{s:sp_val}" hittest="false" />
									<Label class="sc-unit" text="U/S" hittest="false" />
								</Panel>
								<Panel id="sp_bar" class="sc-bar" hittest="false">
									<Panel id="sp_fill" class="sc-fill p0" hittest="false" />
									<Panel id="sp_cap" class="sc-cap cap-5" hittest="false" />
								</Panel>
								<Panel class="sc-sub" hittest="false">
									<Label class="sc-sk" text="PRE" hittest="false" />
									<Label class="sc-sv" text="{s:sp_pre}" hittest="false" />
									<Label class="sc-sk sc-sync" text="SYNC" hittest="false" />
									<Label class="sc-sv sc-sync" text="{s:sp_sync}" hittest="false" />
								</Panel>
								<Label class="sc-chip" text="{s:sc_chip}" hittest="false" />
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<!-- keys -->
				<Panel id="st_ks" class="st-pos p-rw" hittest="false">
					<Panel id="st_ks_sz" class="st-sz sz-m" hittest="false">
						<Panel id="ks" class="ks" hittest="false">
							<Panel class="ks-row" hittest="false">
								<Panel id="k_w" class="k" hittest="false">
									<Label class="k-l" text="W" hittest="false" />
								</Panel>
							</Panel>
							<Panel class="ks-row" hittest="false">
								<Panel id="k_a" class="k" hittest="false">
									<Label class="k-l" text="A" hittest="false" />
								</Panel>
								<Panel id="k_s" class="k" hittest="false">
									<Label class="k-l" text="S" hittest="false" />
								</Panel>
								<Panel id="k_d" class="k" hittest="false">
									<Label class="k-l" text="D" hittest="false" />
								</Panel>
								<Panel id="k_e" class="k k-e" hittest="false">
									<Label class="k-l" text="E" hittest="false" />
								</Panel>
							</Panel>
							<Panel class="ks-row" hittest="false">
								<Panel id="k_c" class="k wide" hittest="false">
									<Label class="k-l" text="DUCK" hittest="false" />
								</Panel>
								<Panel id="k_j" class="k wide" hittest="false">
									<Label class="k-l" text="JUMP" hittest="false" />
								</Panel>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<!-- toast (splits and replies) above or under the card, then the card -->
				<Panel id="st_cg" class="st-pos p-bc" hittest="false">
					<Panel id="st_cg_sz" class="st-sz sz-m" hittest="false">
						<Panel id="st_cg_in" class="cg-in" hittest="false">
							<Panel id="tu" class="ts k-msg ts-up" hittest="false">
								<Label class="ts-k" text="{s:ts_k}" hittest="false" />
								<Panel class="ts-split" hittest="false">
									<Label class="ts-t" text="{s:ts_t}" hittest="false" />
									<Panel class="ts-d ts-d1" hittest="false">
										<Label class="ts-dv" text="{s:ts_d1}" hittest="false" />
										<Label class="ts-ds" text="PB" hittest="false" />
									</Panel>
									<Panel class="ts-d ts-d2" hittest="false">
										<Label class="ts-dv" text="{s:ts_d2}" hittest="false" />
										<Label class="ts-ds" text="SR" hittest="false" />
									</Panel>
									<Label class="ts-v" text="{s:ts_v}" hittest="false" />
									<Label class="ts-vd" text="{s:ts_vd}" hittest="false" />
								</Panel>
								<Panel class="ts-msg" hittest="false">
									<Label class="ts-mb" text="{s:ts_mb}" hittest="false" />
									<Label class="ts-m" text="{s:ts_m}" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="tc" class="tc st-start" hittest="false">
								<Panel class="tc-eye" hittest="false">
									<Panel class="tc-ico" hittest="false" />
									<Label class="tc-lead" text="{s:tc_lead}" hittest="false" />
									<Label class="tc-who" text="{s:tc_who}" hittest="false" />
									<Label class="tc-map" text="{s:tc_map}" hittest="false" />
									<Label class="chip c-style" text="{s:c_style}" hittest="false" />
									<Label class="chip c-mode" text="{s:c_mode}" hittest="false" />
									<Label class="chip c-hint" text="!SETTINGS" hittest="false" />
								</Panel>
								<Panel class="tc-main" hittest="false">
									<Label id="tc_time" class="tc-time" text="{s:tc_time}" hittest="false" />
									<Panel class="tc-side" hittest="false">
										<Panel class="tc-stage" hittest="false">
											<Label class="tc-stk" text="{s:tc_stagek}" hittest="false" />
											<Label class="tc-stv" text="{s:tc_stage}" hittest="false" />
										</Panel>
										<Label class="tc-place" text="{s:tc_place}" hittest="false" />
									</Panel>
									<Label class="tc-diff" text="{s:tc_diff}" hittest="false" />
								</Panel>
								<Panel class="tc-cmp" hittest="false">
									<Panel class="cmp cmp-pb" hittest="false">
										<Label class="cmp-k" text="PB" hittest="false" />
										<Label class="cmp-v" text="{s:tc_pb}" hittest="false" />
									</Panel>
									<Panel class="cmp cmp-sr" hittest="false">
										<Label class="cmp-k" text="{s:tc_srk}" hittest="false" />
										<Label class="cmp-v" text="{s:tc_sr}" hittest="false" />
										<Label class="cmp-by" text="{s:tc_srby}" hittest="false" />
									</Panel>
									<Panel class="fill" hittest="false" />
									<Panel id="tc_ricon" class="tc-ricon" hittest="false" />
									<Label id="tc_rank" class="tc-rank" text="{s:tc_rank}" hittest="false" />
								</Panel>
								<Panel class="tc-res" hittest="false">
									<Label class="tc-rest" text="{s:tc_res}" hittest="false" />
									<Label class="tc-pts" text="{s:tc_pts}" hittest="false" />
								</Panel>
								<Panel id="tc_segs" class="tc-segs" hittest="false">
									<Panel id="sg0" class="sg" hittest="false" />
									<Panel id="sg1" class="sg" hittest="false" />
									<Panel id="sg2" class="sg" hittest="false" />
									<Panel id="sg3" class="sg" hittest="false" />
									<Panel id="sg4" class="sg" hittest="false" />
									<Panel id="sg5" class="sg" hittest="false" />
									<Panel id="sg6" class="sg" hittest="false" />
									<Panel id="sg7" class="sg" hittest="false" />
									<Panel id="sg8" class="sg" hittest="false" />
									<Panel id="sg9" class="sg" hittest="false" />
									<Panel id="sg10" class="sg" hittest="false" />
									<Panel id="sg11" class="sg" hittest="false" />
									<Panel id="sg12" class="sg" hittest="false" />
									<Panel id="sg13" class="sg" hittest="false" />
									<Panel id="sg14" class="sg" hittest="false" />
									<Panel id="sg15" class="sg" hittest="false" />
								</Panel>
								<Panel class="tc-prog" hittest="false">
									<Panel id="tc_prog" class="tc-pfill p0" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="td" class="ts k-msg ts-dn hidden" hittest="false">
								<Label class="ts-k" text="{s:ts_k}" hittest="false" />
								<Panel class="ts-split" hittest="false">
									<Label class="ts-t" text="{s:ts_t}" hittest="false" />
									<Panel class="ts-d ts-d1" hittest="false">
										<Label class="ts-dv" text="{s:ts_d1}" hittest="false" />
										<Label class="ts-ds" text="PB" hittest="false" />
									</Panel>
									<Panel class="ts-d ts-d2" hittest="false">
										<Label class="ts-dv" text="{s:ts_d2}" hittest="false" />
										<Label class="ts-ds" text="SR" hittest="false" />
									</Panel>
									<Label class="ts-v" text="{s:ts_v}" hittest="false" />
									<Label class="ts-vd" text="{s:ts_vd}" hittest="false" />
								</Panel>
								<Panel class="ts-msg" hittest="false">
									<Label class="ts-mb" text="{s:ts_mb}" hittest="false" />
									<Label class="ts-m" text="{s:ts_m}" hittest="false" />
								</Panel>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<!-- the toast on its own, when the player puts it somewhere else -->
				<Panel id="st_tf" class="st-pos p-tc" hittest="false">
					<Panel id="st_tf_sz" class="st-sz sz-m" hittest="false">
						<Panel id="tf" class="ts k-msg ts-free" hittest="false">
							<Label class="ts-k" text="{s:ts_k}" hittest="false" />
							<Panel class="ts-split" hittest="false">
								<Label class="ts-t" text="{s:ts_t}" hittest="false" />
								<Panel class="ts-d ts-d1" hittest="false">
									<Label class="ts-dv" text="{s:ts_d1}" hittest="false" />
									<Label class="ts-ds" text="PB" hittest="false" />
								</Panel>
								<Panel class="ts-d ts-d2" hittest="false">
									<Label class="ts-dv" text="{s:ts_d2}" hittest="false" />
									<Label class="ts-ds" text="SR" hittest="false" />
								</Panel>
								<Label class="ts-v" text="{s:ts_v}" hittest="false" />
								<Label class="ts-vd" text="{s:ts_vd}" hittest="false" />
							</Panel>
							<Panel class="ts-msg" hittest="false">
								<Label class="ts-mb" text="{s:ts_mb}" hittest="false" />
								<Label class="ts-m" text="{s:ts_m}" hittest="false" />
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<!-- other players' records -->
				<Panel id="st_fd" class="st-pos p-tr" hittest="false">
					<Panel id="st_fd_sz" class="st-sz sz-m" hittest="false">
						<Panel id="fd" class="fd" hittest="false">
							<Panel id="fd0" class="fd-slot hidden" hittest="false">
								<Panel id="fd0_row" class="fd-row k-fin" hittest="false">
									<Panel class="fd-ico" hittest="false" />
									<Label class="fd-n" text="{s:fd0_n}" hittest="false" />
									<Label class="fd-tag" text="{s:fd0_tag}" hittest="false" />
									<Label class="fd-t" text="{s:fd0_t}" hittest="false" />
									<Label class="fd-d" text="{s:fd0_d}" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="fd1" class="fd-slot hidden" hittest="false">
								<Panel id="fd1_row" class="fd-row k-fin" hittest="false">
									<Panel class="fd-ico" hittest="false" />
									<Label class="fd-n" text="{s:fd1_n}" hittest="false" />
									<Label class="fd-tag" text="{s:fd1_tag}" hittest="false" />
									<Label class="fd-t" text="{s:fd1_t}" hittest="false" />
									<Label class="fd-d" text="{s:fd1_d}" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="fd2" class="fd-slot hidden" hittest="false">
								<Panel id="fd2_row" class="fd-row k-fin" hittest="false">
									<Panel class="fd-ico" hittest="false" />
									<Label class="fd-n" text="{s:fd2_n}" hittest="false" />
									<Label class="fd-tag" text="{s:fd2_tag}" hittest="false" />
									<Label class="fd-t" text="{s:fd2_t}" hittest="false" />
									<Label class="fd-d" text="{s:fd2_d}" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="fd3" class="fd-slot hidden" hittest="false">
								<Panel id="fd3_row" class="fd-row k-fin" hittest="false">
									<Panel class="fd-ico" hittest="false" />
									<Label class="fd-n" text="{s:fd3_n}" hittest="false" />
									<Label class="fd-tag" text="{s:fd3_tag}" hittest="false" />
									<Label class="fd-t" text="{s:fd3_t}" hittest="false" />
									<Label class="fd-d" text="{s:fd3_d}" hittest="false" />
								</Panel>
							</Panel>
							<Panel id="fd4" class="fd-slot hidden" hittest="false">
								<Panel id="fd4_row" class="fd-row k-fin" hittest="false">
									<Panel class="fd-ico" hittest="false" />
									<Label class="fd-n" text="{s:fd4_n}" hittest="false" />
									<Label class="fd-tag" text="{s:fd4_tag}" hittest="false" />
									<Label class="fd-t" text="{s:fd4_t}" hittest="false" />
									<Label class="fd-d" text="{s:fd4_d}" hittest="false" />
								</Panel>
							</Panel>
						</Panel>
					</Panel>
				</Panel>
				<!-- the map's top times -->
				<Panel id="st_mr" class="st-pos p-tl" hittest="false">
					<Panel id="st_mr_sz" class="st-sz sz-m" hittest="false">
						<Panel id="mr" class="mr" hittest="false">
							<Panel class="mr-head" hittest="false">
								<Panel class="mr-ico" hittest="false" />
								<Label class="mr-k" text="MAP RECORDS" hittest="false" />
								<Panel class="fill" hittest="false" />
								<Label class="mr-sub" text="{s:mr_sub}" hittest="false" />
							</Panel>
							<Panel id="mr0" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr0_p}" hittest="false" />
