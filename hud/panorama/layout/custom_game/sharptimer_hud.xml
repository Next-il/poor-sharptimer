								<Label class="mr-t" text="{s:mr7_t}" hittest="false" />
							</Panel>
							<Panel id="mr8" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr8_p}" hittest="false" />
								<Label class="mr-n" text="{s:mr8_n}" hittest="false" />
