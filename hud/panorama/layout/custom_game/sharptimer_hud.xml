								<Label class="mr-p" text="{s:mr6_p}" hittest="false" />
								<Label class="mr-n" text="{s:mr6_n}" hittest="false" />
								<Label class="mr-t" text="{s:mr6_t}" hittest="false" />
							</Panel>
							<Panel id="mr7" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr7_p}" hittest="false" />
