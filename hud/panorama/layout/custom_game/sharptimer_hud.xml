							<Panel id="mr_me" class="mr-row mr-me hidden" hittest="false">
								<Label class="mr-p" text="{s:mr_me_p}" hittest="false" />
								<Label class="mr-n" text="{s:mr_me_n}" hittest="false" />
								<Label class="mr-t" text="{s:mr_me_t}" hittest="false" />
