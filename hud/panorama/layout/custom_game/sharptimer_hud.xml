							<Panel id="mr2" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr2_p}" hittest="false" />
								<Label class="mr-n" text="{s:mr2_n}" hittest="false" />
								<Label class="mr-t" text="{s:mr2_t}" hittest="false" />
							</Panel>
							<Panel id="mr3" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr3_p}" hittest="false" />
								<Label class="mr-n" text="{s:mr3_n}" hittest="false" />
								<Label class="mr-t" text="{s:mr3_t}" hittest="false" />
							</Panel>
							<Panel id="mr4" class="mr-row hidden" hittest="false">
								<Label class="mr-p" text="{s:mr4_p}" hittest="false" />
