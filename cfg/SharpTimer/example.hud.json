{
  // SharpTimer Panorama HUD. Copy to hud.json to change anything; every key is optional and the plugin never
  // writes this file. Values below are the code defaults. Read on plugin load and on every map start
  // ("Enabled" only on a plugin load).

  // false = SharpTimer's center HTML, exactly as before. true = the Panorama HUD (needs the workshop addon with
  // sharptimer_hud / sharptimer_menu); the center HTML stays for any player the panel cannot reach.
  "Enabled": true,

  // Updates per second. Speed is only sent when the number changed; keys whenever a key changes. TimerRate is
  // the running clock on 1 decimal; on 2 or 3 it goes out every tick (that label only, when its text changed).
  "TimerRate": 10,
  "SpeedRate": 16,
  "SyncRate": 4,
  "PlaceRate": 2,

  // Open questions from the design, each at today's behaviour:
  "FeedFinishes": true,          // plain finishes go to everyone's records feed (false: only PBs and records)
  "LivePlace": true,             // the live "#3" on the card while running
  "RankDisplay": "text",         // "text" (name in the rank colour). "icon"/"both" need rank images in the addon, which it does not ship
  "SplitBarOverflow": "count",   // more than 16 stages/checkpoints: "count" (no bar), "group" or "scroll"
  "ShowWorldRecord": false,      // WR as the card's third time (needs a global API key; this fork has none)
  // The SR chat ad is sharptimer_ad_sr_enabled in config.cfg, as before.

  // Chat lines the HUD replaces. true keeps them in chat as well. The first three are only the defaults of each
  // player's Chat tab in !hud (splits, finish messages, speed in chat); players change their own.
  "SplitsInChat": false,
  "RecordsInChat": false,
  "StartSpeedInChat": false,
  "RepliesInChat": false,

  // Seconds.
  "ResultSeconds": 6,
  "ToastSeconds": 3,
  "FeedSeconds": 4.5,
  "FeedRecordSeconds": 6.5,
  "StartChipSeconds": 2,

  // The speed bar's full scale in u/s (50 steps).
  "SpeedBarMax": 3500,

  // Map records: the map's top times (main course, the player's mode, normal style), from SharpTimer's record
  // cache, which loads on a map start and again after a new PB. Rows on screen, rows while !hud is open (1-10),
  // and how long "on map join" keeps them up after joining or a map start.
  "MapRecordsRows": 3,
  "MapRecordsMenuRows": 10,
  "MapRecordsJoinSeconds": 10,

  // Until a player has opened !hud once: "!HUD SETTINGS" on the card in the start zone and one chat line after joining.
  "SettingsHint": true,

  // What a player gets until they change it in !hud (or !settings / !hudsettings).
  // Spots: tl tc tr (top left/center/right), ml mr (middle left/right), xa xu (above/under the crosshair),
  // bc br (bottom center/right), rw (right side, above the weapon list). Sizes: s m l.
  // Cluster is the speed readout (it was speed + keys); it also takes "nx" (next to the card). Toast also takes
  // "card" (with it). Two parts on one spot: the keys move, then the map records.
  "Defaults": {
    "Card": "bc",
    "CardSize": "m",
    "Cluster": "xu",
    "ClusterSize": "m",
    "Keys": "rw",
    "KeysSize": "m",
    "KeysLayout": "grid",          // "grid" or "row"
    "Toast": "card",
    "ToastSize": "m",
    "Feed": "tr",
    "FeedSize": "m",
    "MapRecords": "tl",            // under the radar and money; the feed has the top right
    "MapRecordsSize": "m",

    // Show / hide. The timer HUD, keys and split toast switches are !hud on|off, !keys and !splits, per player.
    "CardOn": true,
    "Speed": true,
    "SpeedBar": true,
    "Sync": true,
    "Compare": true,               // PB and SR on the card
    "Rank": true,
    "FeedOn": true,
    "MapRecordsOn": true,
    "MapRecordsShow": "always",    // "always", "join" (a few seconds after joining or a map start) or "hud" (only in !hud)

    // Style.
    "Accent": "ice",               // ice, orange, pink, lime, white
    "CompactCard": false,
    "Opacity": "md",               // lo (light), md, hi (solid)
    "TextSize": "m",
    "TimerDecimals": 3             // the running clock: 1, 2 or 3 digits after the second
  }
}
